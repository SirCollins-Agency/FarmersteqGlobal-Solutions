# Local-only credential handoff for distribution commands.
# Copy to .env (gitignored) and fill with ROTATED, least-privilege values.
# Never commit this file or paste tokens into chat.

# GitHub: classic PAT with `repo` (or fine-grained with Contents: write, Releases: write,
# and repository creation if the target repo does not exist yet).
GITHUB_TOKEN=

# Cloudflare: Pages edit + Account read, scoped to farmersteq-pages.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
